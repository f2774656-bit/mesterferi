# Required: set a long unique password before first deployment (12+ characters recommended)
ADMIN_PASSWORD=replace-with-a-long-random-password
# Railway injects PORT for the HTTP dashboard. Do not hard-code it in Railway.
PORT=3000
# Internal listener for the MTProto engine; create Railway TCP Proxy for this exact port.
MTG_PORT=3128
# Set these manually from Railway Settings > Networking > TCP Proxy after creating it.
PUBLIC_TCP_HOST=your-service.proxy.rlwy.net
PUBLIC_TCP_PORT=12345
# Persistent volume mount path
DATA_DIR=/data
# Optional: disable auto-start for debugging
AUTO_START_MTG=true
